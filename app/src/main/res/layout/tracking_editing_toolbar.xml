<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_bottom_nav_docked"
        android:paddingVertical="16dp"
        android:elevation="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="24dp">

            <ImageButton
                android:id="@+id/btnCloseTracking"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close_24"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/str_tracking"
                app:tint="@color/activeTool" />

            <TextView
                android:id="@+id/tvTitleTracking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/tracking_title"
                android:textColor="@color/textColor"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/btnApplyTracking"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_check_24"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/tracking_applied"
                android:enabled="false"
                android:alpha="0.4"
                app:tint="@color/activeTool" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvTrackingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:text="@string/tracking_hint_mark"
            android:textColor="@color/toolTextInactive"
            android:textSize="12sp" />

        <!-- Output frame / canvas preset. Chosen BEFORE tracking so the run is committed
             straight onto the timeline with the right canvas, no second dialog. -->
        <TextView
            android:id="@+id/tvFrameOutputLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="24dp"
            android:text="@string/tracking_frame_label"
            android:textColor="@color/textColor"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:id="@+id/frameRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="24dp"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvFrameNone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/frame_output_none"
                    android:textColor="@color/activeTool"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFrameTiktok"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/frame_output_tiktok"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFrameYoutube"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/frame_output_youtube"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFrameIgReel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/frame_output_ig_reel"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFrameIgFeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/frame_output_ig_feed"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvFrameIgSquare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/frame_output_ig_square"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Camera path mode: how the window is allowed to size itself over the shot.
             CLAMP keeps the window fixed (sharpest, subject off-centre at the edges);
             DP solves the path first and buys reach with one steady push-in. -->
        <TextView
            android:id="@+id/tvPathLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="24dp"
            android:text="@string/tracking_path_label"
            android:textColor="@color/textColor"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/pathRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPathClamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/tracking_path_clamp"
                android:textColor="@color/activeTool"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPathDp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/tracking_path_dp"
                android:textColor="@color/toolTextInactive"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Which engine finds the subject. A real trade-off, not a preference: "Current" is the
             built-in template matcher (no model, no extra APK size, loses the subject on rotation
             or low texture); "ML Kit" is on-device face detection (+~7 MB) which holds through
             both. The choice is remembered between sessions. -->
        <TextView
            android:id="@+id/tvEngineLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="24dp"
            android:text="@string/tracking_engine_label"
            android:textColor="@color/textColor"
            android:textSize="12sp" />

        <HorizontalScrollView
            android:id="@+id/engineRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="24dp"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEngineCurrent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/tracking_engine_current"
                    android:textColor="@color/activeTool"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvEngineMlKit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:padding="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:text="@string/tracking_engine_mlkit"
                    android:textColor="@color/toolTextInactive"
                    android:textSize="13sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartTracking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tracking_start"
                android:textSize="13sp" />

            <!-- Auto frame: the same contract as Start Tracking (a timed path of subject
                 centres), but the subject is found by what moves instead of by a drawn box.
                 It is a second entry point to the same state, not a second mode: whatever the
                 path came from, the marker, the camera-path choice, the frame row and every
                 render path below are identical. -->
            <Button
                android:id="@+id/btnAutoFrame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/tracking_auto_frame"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zoomRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/str_zoom_label"
                android:textColor="@color/textColor"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvZoomAuto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/tracking_zoom_auto"
                android:textColor="@color/activeTool"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvZoom15"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/tracking_zoom_15"
                android:textColor="@color/toolTextInactive"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvZoom20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/tracking_zoom_20"
                android:textColor="@color/toolTextInactive"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvZoom30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="@string/tracking_zoom_30"
                android:textColor="@color/toolTextInactive"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
